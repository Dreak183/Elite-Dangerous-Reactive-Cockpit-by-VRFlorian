{
  "schema": "platform.config.v1",
  "active_graph": "stories/yggdrasil/graph.json",
  "graph_manager": {
    "default_graph_id": "yggdrasil",
    "maximum_switches_per_minute": 8
  },
  "journal_dir": "",
  "poll_seconds": 0.2,
  "status_max_initial_age_seconds": 60.0,
  "player_build": true,
  "reactive_cockpit": {
    "enabled": true,
    "install_dir": "..",
    "core_script": "reactive_cockpit.py",
    "theme_cache_dir": "../theme_cache",
    "bundled_theme_cache_dir": "../bundled_theme_cache",
    "edhm_theme_library_dir": "../bundled_edhm_themes"
  },
  "external_story_media_dir": "story_assets",
  "controls": {
    "enabled": true,
    "poll_seconds": 0.03,
    "bindings": {
      "answer": "CTRL+C",
      "accept": "CTRL+A",
      "decline": "CTRL+N",
      "paste": "CTRL+V",
      "scanner": "CTRL+S"
    },
    "feedback": {
      "scanner": {
        "on_asset": "scanner/Scanner activated.mp3",
        "off_asset": "scanner/Scanner deactivated.mp3",
        "volume": 1.0,
        "layer": "system.control.scanner.feedback"
      }
    }
  },
  "developer": {
    "enabled": false,
    "bindings": {
      "toggle": "CTRL+SHIFT+G",
      "back": "CTRL+4",
      "forward": "CTRL+5",
      "next_mission": "CTRL+M"
    }
  },
  "presentation": {
    "enabled": true,
    "status_window": true,
    "window_title": "VRFlorian Reactive Cockpit — Story Mode ON",
    "always_on_top": true,
    "visual_theme_adapter": true,
    "audio_volume_transition_seconds": 2.0
  },
  "player_story_mode": {
    "state_file": "../user_data/launcher_state.json",
    "default_enabled": false
  }
}
